# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored — never commit real keys.
# Where to find them: Supabase dashboard → your project → Project Settings → API keys.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_..., or the legacy "anon" key).
# Used by the app. Read-only because of the RLS policies in schema.sql.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Secret key (sb_secret_..., or the legacy "service_role" key).
# Used ONLY by scraper.py to write. It bypasses RLS, so keep it private.
SUPABASE_SECRET_KEY=your-secret-key

# Optional: "supabase" (default) or "sample" (bundled synthetic data, no keys needed)
# BOOKS_SOURCE=sample
